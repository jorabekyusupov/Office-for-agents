{
  "name": "@ai-office/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src tests --max-warnings=0",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "test:integration": "vitest run tests/health.integration.test.ts"
  },
  "dependencies": {
    "@ai-office/agent-core": "workspace:*",
    "@ai-office/contracts": "workspace:*",
    "@better-auth/prisma-adapter": "^1.7.1",
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^6.19.1",
    "better-auth": "^1.7.1",
    "bullmq": "^6.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.5.0",
    "ioredis": "^6.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "prisma": "^6.19.1",
    "tsx": "^4.20.5"
  }
}
